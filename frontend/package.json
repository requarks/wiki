{
  "name": "wiki-ux",
  "version": "3.0.0",
  "description": "The most powerful and extensible open source Wiki software",
  "productName": "Wiki.js",
  "author": "Nicolas Giard <nick@requarks.io>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vite build --emptyOutDir",
    "ncu": "ncu -i",
    "ncu-u": "ncu -u",
    "icons": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "emoji": "node scripts/generate-emoji.mjs",
    "emoji:check": "node scripts/generate-emoji.mjs --check"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@twemoji/api": "17.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "browser-fs-access": "0.38.0",
    "clipboard": "2.0.11",
    "es-toolkit": "1.50.0",
    "filesize": "11.0.22",
    "filesize-parser": "1.5.2",
    "fuse.js": "7.5.0",
    "highlight.js": "11.11.1",
    "iconify-icon": "3.0.2",
    "js-cookie": "3.0.8",
    "ky": "2.0.2",
    "markdown-it": "15.0.0",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-decorate": "1.2.2",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-expand-tabs": "1.0.13",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-mdc": "0.2.12",
    "markdown-it-multimd-table": "4.2.3",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mitt": "3.0.1",
    "monaco-editor": "0.56.0",
    "pinia": "4.0.2",
    "semver": "7.8.5",
    "slugify": "1.6.9",
    "sortablejs": "1.15.7",
    "sortablejs-vue3": "1.3.0",
    "tailwindcss": "4.3.3",
    "temporal-polyfill": "1.0.2",
    "twemoji-assets": "https://codeload.github.com/jdecked/twemoji/tar.gz/refs/tags/v17.0.3",
    "uuid": "14.0.1",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vue3-otp-input": "0.5.40",
    "vuedraggable": "4.1.0",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "y-websocket": "3.0.0",
    "yjs": "13.6.31",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@iconify-json/la": "1.2.1",
    "@iconify-json/mdi": "1.2.3",
    "@vitejs/plugin-vue": "6.0.8",
    "js-yaml": "5.2.3",
    "npm-check-updates": "23.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "sass": "1.102.0",
    "unicode-emoji-json": "0.9.0",
    "vite": "8.2.0",
    "vite-plugin-vue-devtools": "8.2.1"
  },
  "overrides": {
    "markdown-it-mdc": {
      "markdown-it": "$markdown-it"
    }
  },
  "engines": {
    "node": ">= 26.0"
  }
}
