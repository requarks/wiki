  "devDependencies": {
    "@iconify-json/la": "1.2.1",
    "@iconify-json/mdi": "1.2.3",
    "@vitejs/plugin-vue": "6.0.10",
    "js-yaml": "5.5.0",
    "npm-check-updates": "23.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
