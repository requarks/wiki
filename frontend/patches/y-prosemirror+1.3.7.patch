+/**
+ * The attribute a non-text node's own marks are kept under.
+ *
+ * Text carries its marks as formatting attributes of the Y.XmlText, but an element has nowhere to put
+ * them, so without this the marks on an inline node (a linked image, a bold emoji) were dropped on the
+ * way into the shared document. Stored as the marks' JSON, and never handed to ProseMirror as an attr.
+ */
+const YMARKS = 'ymarks'
+
+/**
+ * @param {ReadonlyArray<import('prosemirror-model').Mark>} marks
+ * @return {Array<any>|null} null when there is nothing to store
+ */
+const nodeMarksToYAttr = (marks) => {
+  const json = marks
+    .filter((mark) => mark.type.name !== 'ychange')
+    .map((mark) => mark.toJSON())
+  return json.length > 0 ? json : null
+}
+
+/**
