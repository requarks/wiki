+ * @param {import('prosemirror-model').Schema} schema
+ * @return {Array<import('prosemirror-model').Mark>}
+ */
+const yAttrToNodeMarks = (ymarks, schema) =>
+  Array.isArray(ymarks)
+    ? ymarks
+      .filter((json) => json && schema.marks[json.type])
+      .map((json) => schema.markFromJSON(json))
+    : []
