{
  "comments": true,
  "plugins": [
    "lodash",
    "graphql-tag",
    [
      "prismjs", {
        "languages": ["clike", "markup"],
        "plugins": ["line-numbers", "autoloader", "normalize-whitespace", "copy-to-clipboard", "toolbar"],
        "theme": "twilight",
        "css": true
      }
    ]
  ],
  "presets": [
    [
      "@babel/preset-env", {
        "useBuiltIns": "entry",
        "corejs": "3.50",
        "debug": false
      }
    ]
  ]
}
