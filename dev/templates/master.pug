doctype html
html(lang=siteConfig.lang)
  head
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(charset='UTF-8')
    meta(name='viewport', content='user-scalable=yes, width=device-width, initial-scale=1, maximum-scale=5')
    meta(name='theme-color', content='#1976d2')
    meta(name='apple-mobile-web-app-title', content='Sunni Noor')
    style.
      @media (max-width: 959.99px) {
        .v-app-bar.nav-header,
        .nav-header .nav-header-mobile.v-toolbar {
          background-color: #192B85 !important;
        }
        .theme--dark .v-app-bar.nav-header,
        .theme--dark .nav-header .nav-header-mobile.v-toolbar {
          background-color: #0D47A1 !important;
        }
      }
      @media (min-width: 960px) {
        .v-app-bar.nav-header,
        .nav-header .nav-header-inner.v-toolbar {
          background-color: #192B85 !important;
        }
        .theme--dark .v-app-bar.nav-header,
        .theme--dark .nav-header .nav-header-inner.v-toolbar {
          background-color: #0D47A1 !important;
        }
      }
      html.wiki-auth-guest [data-auth-required],
      html.wiki-auth-guest .wiki-auth-blocked {
        pointer-events: none !important;
        cursor: default !important;
      }
      html.wiki-auth-guest [data-auth-required] .v-icon,
      html.wiki-auth-guest .wiki-auth-blocked .v-icon {
        color: rgba(255, 255, 255, 0.38) !important;
      }
      html.wiki-auth-guest [data-auth-required].v-btn--disabled .v-icon,
      html.wiki-auth-guest .wiki-auth-blocked.v-btn--disabled .v-icon {
        color: rgba(255, 255, 255, 0.38) !important;
      }
    meta(name='msapplication-TileColor', content='#1976d2')
    meta(name='msapplication-TileImage', content='/_assets/favicons/mstile-150x150.png')

    title= pageMeta.title + ' | ' + config.title

    //- SEO / OpenGraph
    meta(name='description', content=pageMeta.description)
    meta(property='og:title', content=pageMeta.title)
    meta(property='og:type', content='website')
    meta(property='og:description', content=pageMeta.description)
    meta(property='og:image', content=pageMeta.image)
    meta(property='og:url', content=pageMeta.url)
    meta(property='og:site_name', content=config.title)

    //- Favicon
    link(rel='apple-touch-icon', sizes='180x180', href='/_assets/favicons/apple-touch-icon.png')
    link(rel='icon', type='image/png', sizes='192x192', href='/_assets/favicons/android-chrome-192x192.png')
    link(rel='icon', type='image/png', sizes='32x32', href='/_assets/favicons/favicon-32x32.png')
    link(rel='icon', type='image/png', sizes='16x16', href='/_assets/favicons/favicon-16x16.png')
    link(rel='mask-icon', href='/_assets/favicons/safari-pinned-tab.svg', color='#1976d2')
    link(rel='manifest', href='/manifest.webmanifest')

    //- Site Properties
    script.
      var siteConfig = !{JSON.stringify(siteConfig)}
      var siteLangs = !{JSON.stringify(langs)}
    script.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {})
        })
      }
    script.
      (function () {
        function parseJwtPayload(jwtToken) {
          if (!jwtToken || typeof jwtToken !== 'string') { return null }
          try {
            var parts = jwtToken.split('.')
            if (parts.length < 2) { return null }
            var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/')
            while (payload.length % 4) { payload += '=' }
            return JSON.parse(atob(payload))
          } catch (err) {
            return null
          }
        }
        function readJwtCookie() {
          var match = document.cookie.match(/(?:^|;\s*)jwt=([^;]*)/)
          return match ? decodeURIComponent(match[1]) : null
        }
        function isAuthenticated() {
          var jwtData = parseJwtPayload(readJwtCookie())
          if (!jwtData) { return false }
          if (jwtData.exp && jwtData.exp * 1000 <= Date.now()) { return false }
          return true
        }
        var authenticated = isAuthenticated()
        var root = document.documentElement
        root.classList.add(authenticated ? 'wiki-auth-authenticated' : 'wiki-auth-guest')
        window.__wikiAuth = { authenticated: authenticated }
      })()

    //- Dev Mode Warning
    if devMode
      script.
        siteConfig.devMode = true

    //- Icon Set
    if config.theming.iconset === 'fa'
      link(
        type='text/css'
        rel='stylesheet'
        href='https://use.fontawesome.com/releases/v5.10.0/css/all.css'
        )
    else if config.theming.iconset === 'fa4'
      link(
        type='text/css'
        rel='stylesheet'
        href='https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css'
        )

    //- CSS
    <% for (var index in htmlWebpackPlugin.files.css) { %>
      <% if (htmlWebpackPlugin.files.cssIntegrity) { %>
    link(
      type='text/css'
      rel='stylesheet'
      href='<%= htmlWebpackPlugin.files.css[index] %>'
      integrity=config.security.securitySRI ? '<%= htmlWebpackPlugin.files.cssIntegrity[index] %>' : false
      crossorigin='<%= webpackConfig.output.crossOriginLoading %>'
    )
      <% } else { %>
    link(
      type='text/css'
      rel='stylesheet'
      href='<%= htmlWebpackPlugin.files.css[index] %>'
    )
      <% } %>
    <% } %>

    if injectCode && injectCode.css
      style(type='text/css')!= injectCode.css
    if injectCode && injectCode.head
      != injectCode.head

    //- JS
    <% for (var index in htmlWebpackPlugin.files.js) { %>
      <% if (htmlWebpackPlugin.files.jsIntegrity) { %>
    script(
      type='text/javascript'
      src='<%= htmlWebpackPlugin.files.js[index] %>'
      integrity=config.security.securitySRI ? '<%= htmlWebpackPlugin.files.jsIntegrity[index] %>' : false
      crossorigin='<%= webpackConfig.output.crossOriginLoading %>'
      )
      <% } else { %>
    script(
      type='text/javascript'
      src='<%= htmlWebpackPlugin.files.js[index] %>'
      )
      <% } %>
    <% } %>

    != analyticsCode.head

    block head

  body
    != analyticsCode.bodyStart
    block body
    != analyticsCode.bodyEnd
